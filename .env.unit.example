# ============================================
# Allerac One - env file for an additional Unit on the same host
# ============================================
# A Unit is one isolated Allerac stack: its own containers, database volume,
# network and host ports. The primary install keeps using .env; every other
# Unit gets its own file, e.g. .env.website (all .env* files are git-ignored).
#
#   cp .env.unit.example .env.website      # then fill in the secrets below
#   docker compose --env-file .env.website up -d --build
#   docker compose --env-file .env.website ps
#
# ALLERAC_UNIT also sets the Compose project name, so `-p website` is optional
# (if you pass -p, use the same value). Always pass --env-file: without it
# Compose falls back to .env, which is the primary Unit.
# Allerac's own scripts take the same file:
#   ALLERAC_ENV_FILE=.env.website ./allerac.sh backup
#   ALLERAC_ENV_FILE=.env.website DEPLOY_BRANCH=main ./update.sh
#
# Full guide: docs/operations/multi-unit.md

# --------------------------------------------
# Identity
# --------------------------------------------
# Lowercase letters, digits, '-' or '_'. Becomes the project name, the
# container prefix (website-app, website-db, ...) and the volume prefix
# (website_db_data, ...). Never reuse the name of another Unit.
ALLERAC_UNIT=website
# This file's own name: it is loaded into the app container.
ALLERAC_ENV_FILE=.env.website

# Lean public profile: no shell executor, no Portainer, no host-level
# monitoring, no docs server. Remove this line for a full second Unit
# (then also give it its own EXECUTOR_DEV_PORT / EXECUTOR_DEV_PORT_RANGE).
COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
# Optional Compose profiles for this Unit (cloud = its own Cloudflare Tunnel
# connector, health = health-worker for the health module).
COMPOSE_PROFILES=
# Optional modules for this Unit: all (default) | personal | openworld | sales,
# or an explicit ALLERAC_MODULES list. See deploy/profiles/ and
# docs/operations/modules-and-profiles.md.
# ALLERAC_PROFILE=openworld

# --------------------------------------------
# Host ports: must not collide with any other Unit
# --------------------------------------------
APP_PORT=8081
OLLAMA_PORT=11435
DOCS_PORT=8001
N8N_PORT=5679
WEBHOOK_PORT=10000
EXECUTOR_DEV_PORT=3020
EXECUTOR_DEV_PORT_RANGE=3022-3030
NODE_EXPORTER_PORT=9101
PROMETHEUS_PORT=9091
LOKI_PORT=3101
PORTAINER_PORT=9001
GARMIN_WORKER_PORT=8788
CADDY_HTTP_PORT=8880
CADDY_HTTPS_PORT=8443

# Public URL of this Unit (one hostname per Unit, see the docs)
APP_URL=https://website.example.com
NEXT_PUBLIC_API_URL=https://website.example.com

# --------------------------------------------
# Secrets: generate NEW values, never copy them from another Unit
# --------------------------------------------
# openssl rand -hex 32
ENCRYPTION_KEY=
TELEGRAM_TOKEN_ENCRYPTION_KEY=
# Still required without the executor: it authenticates internal calls
# (scheduled jobs, service logs).
EXECUTOR_SECRET=
POSTGRES_PASSWORD=
# Only needed if you enable COMPOSE_PROFILES=automation
N8N_ENCRYPTION_KEY=

# --------------------------------------------
# Access
# --------------------------------------------
ALLOW_REGISTRATION=false

# Cloudflare Tunnel token for THIS Unit (if it runs its own connector)
# TUNNEL_TOKEN=

# --------------------------------------------
# Resources (optional)
# --------------------------------------------
APP_MEM_LIMIT=768M
DB_MEM_LIMIT=384M
OLLAMA_MEM_LIMIT=4g
# APP_CPUS=1
# DB_CPUS=0.5
# OLLAMA_CPUS=2
OLLAMA_MODELS=qwen2.5:3b,embeddinggemma

# --------------------------------------------
# Federation manifest (/.well-known/allerac) - all optional
# --------------------------------------------
# See docs/api/federation-manifest.md
# ALLERAC_FEDERATION_MANIFEST=true      # set to false to return 404
# ALLERAC_UNIT_NAME=                    # manifest unit name (defaults to ALLERAC_UNIT, then "allerac")
# ALLERAC_UNIT_DISPLAY_NAME=            # human label (defaults to the unit name)
# ALLERAC_PUBLIC_URL=                   # canonical URL (defaults to the request origin)
# ALLERAC_PAIRING_ACCEPT=false          # advertise that this Unit accepts pairing
# ALLERAC_PAIRING_ACCEPT_PUBLIC=false   # also required on public profiles (openworld, sales)
# ALLERAC_FEDERATION_CAPABILITIES=      # comma list narrowing advertised capability ids
