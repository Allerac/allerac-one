# Allerac One - "personal" profile (example).
# Core + personal modules: health (Garmin/Strava), music (Spotify), email, social.
# Merge these lines into the Unit's env file (.env or .env.<unit>).
# See docs/operations/modules-and-profiles.md.

ALLERAC_PROFILE=personal
# Optional explicit override (wins over ALLERAC_PROFILE), e.g. without social:
# ALLERAC_MODULES=health,music,email

# install.sh, update.sh and `allerac start` derive the Compose profile
# "health" (health-worker) from ALLERAC_PROFILE and merge it with any
# COMPOSE_PROFILES you already have (e.g. local,webhook). Only plain
# `docker compose up` needs it spelled out:
# COMPOSE_PROFILES=health,local,webhook

# Module secrets (fill in what you use):
HEALTH_WORKER_SECRET=
# HEALTH_WORKER_URL defaults to http://health-worker:8001
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
