# ============================================
# Allerac One - Local Hardware Line
# ============================================
# Copy to .env and fill in your values:
#   cp .env.local.example .env
#
# Or use the installer which generates this automatically:
#   ./install.sh
#
# Required:  ENCRYPTION_KEY
# Optional:  everything else (local AI works without external APIs)
# ============================================

# --------------------------------------------
# REQUIRED: Security (auto-generated by installer)
# Generate manually: openssl rand -hex 32
# --------------------------------------------
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# AES key for encrypting Telegram bot tokens (needed if using Telegram)
# Generate: openssl rand -hex 32
TELEGRAM_TOKEN_ENCRYPTION_KEY=

# Secret for executor API authentication (REQUIRED, at least 32 characters;
# the executor refuses to start without it)
# Generate: openssl rand -hex 32
EXECUTOR_SECRET=

# --------------------------------------------
# Hardware tier: models to download with Ollama
#
# Allerac Lite  (N100, 16GB):  qwen2.5:3b
# Allerac Home  (i5/R5, 32GB): qwen2.5:3b
# Allerac Pro   (i7/R7, 64GB): qwen2.5:3b
# --------------------------------------------
OLLAMA_MODELS=qwen2.5:3b,embeddinggemma
# GPU acceleration (auto-detected by install.sh)
# true  → uses docker-compose.local.gpu.yml override (requires nvidia-container-toolkit)
# false → CPU only
ENABLE_GPU=false

# Max RAM for Ollama container. Adjust to your hardware:
#   8GB  machine: OLLAMA_MEM_LIMIT=4g
#   16GB machine: OLLAMA_MEM_LIMIT=10g
#   32GB machine: OLLAMA_MEM_LIMIT=24g
OLLAMA_MEM_LIMIT=10g

# CPU threads for Ollama inference (leave 1 core free for the OS)
# N100 (4 cores) → 3, i5 (8 cores) → 6, i7 (12+ cores) → 10
OLLAMA_NUM_THREAD=3

# Keep model loaded in RAM between requests (avoids costly reloads)
OLLAMA_KEEP_ALIVE=1h

# Ollama API endpoint
# - Containerized Ollama (default): http://ollama:11434
# - Ollama installed on host:       http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_KEEP_ALIVE=10m
EMBEDDING_VERSION=ollama:embeddinggemma:v1

# --------------------------------------------
# Database (no changes needed for local use)
# --------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=allerac

# --------------------------------------------
# Application ports
# --------------------------------------------
APP_PORT=8080
OLLAMA_PORT=11434
GRAFANA_PORT=3001

# --------------------------------------------
# Access control
# --------------------------------------------
# Public sign-up. false = only the first (admin) account and admin invites.
ALLOW_REGISTRATION=false
# Shell / workspace access is admin-only. Optionally allow specific non-admin
# users by user ID (UUID), comma-separated.
SHELL_ALLOWED_USER_IDS=

# --------------------------------------------
# Executor workspace
# The AI shell works in the Docker volume allerac_executor_workspace. It no
# longer sees your home directory (HOST_WORKSPACE was removed).
# Optional: a host folder instead, owned by uid 10001 — never /home or the
# install folder. Example: EXECUTOR_WORKSPACE=/srv/allerac-workspace
# --------------------------------------------
# EXECUTOR_WORKSPACE=
# Workspace dev-server ports (3000,3002-3010) bind to loopback by default.
# EXECUTOR_DEV_PORTS_BIND=127.0.0.1

# Optional GitHub token for shell commands in the executor (git clone/pull/push,
# curl to the GitHub API). Use a FINE-GRAINED token limited to the repos the
# agent may touch, with only Contents + Pull requests (read/write) (+ Issues
# read/write if the bug-hunter skill should open issues). Shell commands see it
# as GH_TOKEN / GITHUB_TOKEN; git uses it for https://github.com automatically.
# GITHUB_TOKEN / GITHUB_PAT above are NOT passed to the executor.
# EXECUTOR_GITHUB_TOKEN=

# --------------------------------------------
# Monitoring (used with --profile monitoring)
# --------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --------------------------------------------
# External APIs (optional — local AI works without them)
# --------------------------------------------

# Web search via Tavily (https://tavily.com)
TAVILY_API_KEY=

# TikTok Login Kit and Content Posting API (optional)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/tiktok/callback
# Must match the public TikTok directory verified in TikTok for Developers.
TIKTOK_MEDIA_URL_PREFIX=

# Spotify Web API (optional) — powers the Music domain's own recommendation engine.
# Create an app at https://developer.spotify.com/dashboard and set its Redirect URI
# to match SPOTIFY_REDIRECT_URI below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-domain.example/api/spotify/callback

# Strava API (optional) — Health activity synchronization.
# The Authorization Callback Domain in Strava must match this host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://your-domain.example/api/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=

# --------------------------------------------
# allerac-health integration (optional)
# Enables the Health Assistant skill with real Garmin data.
# --------------------------------------------
# URL of the allerac-health backend.
# When running on the same VM: http://allerac-health-backend:8000
HEALTH_API_URL=http://allerac-health-backend:8000

# Public URL opened by the Docs shortcut in the Hub.
# Local fallback when omitted: http://<current-host>:8000
NEXT_PUBLIC_DOCS_URL=http://localhost:8000
# Shared secret for signing health API tokens.
# Generate: openssl rand -hex 32
# Must match ALLERAC_ONE_SECRET_KEY in allerac-health .env
HEALTH_API_SECRET_KEY=

# GitHub Models API — cloud LLM fallback
# Users can also set this in the app UI under Settings
GITHUB_TOKEN=

# --------------------------------------------
# Notifications (used with --profile notifications)
# Create a bot at https://t.me/BotFather
# --------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_DEFAULT_USER=

# Model used by the notifier service for generating notification content
NOTIFIER_LLM_MODEL=qwen2.5:3b

# --------------------------------------------
# Deploy webhook (optional, used with COMPOSE_PROFILES=webhook)
# --------------------------------------------
# Branch accepted by the deploy webhook. For sandbox, use development or a feature
# branch while testing. For production, use main.
DEPLOY_BRANCH=development
# Absolute repository path on deployment hosts. Required by the webhook container
# because it controls the host Docker daemon through /var/run/docker.sock.
COMPOSE_DIR=
# GitHub webhook secret. Generate: openssl rand -hex 32
WEBHOOK_SECRET=
# Optional token used by update.sh/git pull when the repo is private.
GITHUB_DEPLOY_TOKEN=
# Human-readable name used in deploy notifications.
DEPLOY_VM_NAME=sandbox-home
# Optional Telegram notification for deploy results.
TELEGRAM_DEPLOY_BOT_TOKEN=
TELEGRAM_DEPLOY_CHAT_ID=
