meta {
  name: Create API Key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/api-keys
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: session_token={{sessionToken}}
}

body:json {
  {
    "name": "Bruno smoke",
    "scopes": [
      "profile:read",
      "domains:read",
      "capabilities:read",
      "chat:read",
      "chat:write",
      "memory:read",
      "memory:write",
      "documents:read",
      "documents:write",
      "notes:read",
      "notes:write",
      "search:read",
      "tickets:read",
      "tickets:write",
      "agents:read",
      "agents:write",
      "jobs:read",
      "jobs:write",
      "skills:read",
      "skills:write",
      "benchmark:read",
      "benchmark:write",
      "crawler:sources:write",
      "crawler:runs:write",
      "crawler:runs:claim",
      "crawler:runs:heartbeat",
      "crawler:events:write",
      "crawler:documents:write",
      "health:read",
      "health:write",
      "health:proxy:read",
      "email:read",
      "email:write",
      "finance:read",
      "finance:write",
      "music:read",
      "music:write"
    ]
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.data?.secret) {
    bru.setEnvVar("apiKey", body.data.secret);
  }
  if (body?.data?.apiKey?.id) {
    bru.setEnvVar("apiKeyId", body.data.apiKey.id);
  }
}
