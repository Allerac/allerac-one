meta {
  name: 03 Claim Run
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/crawler/runs/claim
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{apiKey}}
}

body:json {
  {
    "workerId": "{{crawlerWorkerId}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.runId) {
    bru.setEnvVar("crawlerRunId", body.runId);
  }
}

docs {
  Claims the oldest eligible run for two minutes.
  A 204 response means there is no pending work.
  Required scope: crawler:runs:claim.
}

