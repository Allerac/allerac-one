meta {
  name: List Activities
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/health/activities?limit=10
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{apiKey}}
}

script:post-response {
  const body = res.getBody();
  const first = body?.data?.activities?.[0];
  if (first?.activity_id) {
    bru.setEnvVar("activityId", first.activity_id);
  }
}
