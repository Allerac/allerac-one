meta {
  name: Sync Activity Detail
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/health/activities/{{activityId}}/sync
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{apiKey}}
}

docs {
  Run "List Activities" first to populate activityId.
  Required scope: health:write. Queues a background detail sync (laps/zones/
  route/series) — processed asynchronously by agent-worker, returns 202
  immediately. Safe to call repeatedly.
}
