meta {
  name: Proxy Activity Laps
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/health/proxy/activities/{{proxyActivityId}}/laps
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{apiKey}}
}

docs {
  Run "Proxy Activities" first to populate proxyActivityId.
  Independent live call to the health-worker's /activity-details, sliced to
  just laps. Never written to health_activity_laps.
}
