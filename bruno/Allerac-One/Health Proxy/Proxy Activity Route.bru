meta {
  name: Proxy Activity Route
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/health/proxy/activities/{{proxyActivityId}}/route
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{apiKey}}
}

docs {
  Run "Proxy Activities" first to populate proxyActivityId.
  Independent live call to the health-worker's /activity-details, sliced to
  route_bounds/route_simplified_polyline/samples. Includes exact GPS
  coordinates, unredacted — treat as sensitive.
}
