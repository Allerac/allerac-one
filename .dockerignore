# Infrastructure files
infra/
pipelines/

# Dependencies
node_modules/

# Build output
.next/
out/
build/

# Version control
.git/
.gitignore

# Documentation (docs/ is copied only into the `docs` build stage; the app
# builder does not need it)
*.md

# IDE and OS files
.DS_Store
.vscode/
.idea/

# Environment files (will be passed via docker-compose)
.env*

# Claude config
.claude/

# Workspace runtime data (not needed for build)
workspace/

# Test files
tests/
e2e/
coverage/
src/__tests__/

# Misc large files not needed at runtime
tsconfig.tsbuildinfo
allerac-icon-1024.png

# Locally built docs site (the image builds its own in the `docs` stage)
docs-site/
